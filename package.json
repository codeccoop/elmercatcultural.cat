{
  "name": "elmercat",
  "version": "1.4.0",
  "description": "Wpct child theme for sommobiliat.coop web",
  "author": "Còdec",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/codeccoop/sommobilitat/wp/wpct-sm"
  },
  "theme_uri": "https://gitlab.com/codeccoop/sommobilitat/wp/wpct-sm",
  "author_uri": "https://www.codeccoop.org",
  "text_domain": "wpct-sm",
  "license": "GPL-2.0-or-later",
  "rtlcssConfig": {
    "options": {
      "autoRename": false,
      "autoRenameStrict": false,
      "blacklist": {},
      "clean": true,
      "greedy": false,
      "processUrls": false,
      "stringMap": []
    },
    "plugins": [],
    "map": false
  },
  "scripts": {
    "start": "node-sass sass/ -o ./ --source-map true --output-style expanded --indent-type tab --indent-width 1 -w",
    "watch": "node-sass sass/ -o ./ --source-map true --output-style expanded --indent-type tab --indent-width 1 -w",
    "compile:css": "node-sass sass/ -o ./ && stylelint '*.css' --fix || true && stylelint '*.css' --fix",
    "compile:rtl": "rtlcss style.css style-rtl.css",
    "lint:scss": "wp-scripts lint-style 'sass/**/*.scss'",
    "lint:js": "wp-scripts lint-js 'js/*.js'",
    "bundle": "dir-archiver --src . --dest ../_s.zip --exclude .DS_Store .stylelintrc.json .eslintrc .git .gitattributes .github .gitignore README.md composer.json composer.lock node_modules vendor package-lock.json package.json .travis.yml phpcs.xml.dist sass style.css.map yarn.lock"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@prettier/plugin-php": "^0.22.4",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.0.0",
    "@wordpress/scripts": "^19.2.2",
    "concurrently": "^9.1.2",
    "cssnano": "^7.0.6",
    "dir-archiver": "^1.1.1",
    "esbuild": "^0.24.2",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^15.14.0",
    "lint-staged": "^15.4.2",
    "node-sass": "^7.0.3",
    "postcss": "^8.5.1",
    "postcss-cli": "^11.0.0",
    "postcss-url": "^10.1.3",
    "prettier": "^3.4.2",
    "rtlcss": "^3.5.0",
    "tailwindcss": "^4.0.0"
  }
}
